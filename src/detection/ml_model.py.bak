"""
ml_model.py — Module d'intégration ML dans le détecteur temps réel
Charge le modèle entraîné et expose une fonction score_transaction()
"""

import os
import numpy as np
import joblib

# Chemins
_BASE = os.path.dirname(__file__)
_MODEL_PATH   = os.path.join(_BASE, "models", "fraud_model.pkl")
_SCALER_PATH  = os.path.join(_BASE, "models", "scaler.pkl")
_FEATURES_PATH = os.path.join(_BASE, "models", "features.pkl")

_model   = None
_scaler  = None
_features = None


def _load():
    global _model, _scaler, _features
    if _model is None:
        if not os.path.exists(_MODEL_PATH):
            raise FileNotFoundError(
                "Modèle non trouvé. Lancez d'abord notebooks/fraud_ml.py"
            )
        _model    = joblib.load(_MODEL_PATH)
        _scaler   = joblib.load(_SCALER_PATH)
        _features = joblib.load(_FEATURES_PATH)
        print(f"[ML] Modèle chargé depuis {_MODEL_PATH}")


def score_transaction(transaction: dict) -> dict:
    """
    Calcule un score de fraude ML pour une transaction.

    Paramètres
    ----------
    transaction : dict  — une transaction brute (depuis Kafka/MongoDB)

    Retourne
    --------
    dict avec :
        fraud_score   float [0-1]
        is_fraud_ml   bool
        confidence    str  (HIGH / MEDIUM / LOW)
    """
    _load()

    import pandas as pd
    from datetime import datetime

    # ── Feature engineering (identique à fraud_ml.py) ──
    ts = transaction.get("timestamp", "")
    try:
        dt = datetime.fromisoformat(str(ts))
        hour = dt.hour
        day_of_week = dt.weekday()
    except Exception:
        hour = 12
        day_of_week = 0

    amount = float(transaction.get("amount", 0))
    location = str(transaction.get("location", "")).lower()
    device_id = str(transaction.get("device_id", ""))
    tx_type = str(transaction.get("transaction_type", "purchase")).lower()

    type_map = {"purchase": 0, "withdrawal": 1, "transfer": 2, "online": 3}

    features = {
        "amount":               amount,
        "amount_log":           np.log1p(amount),
        "hour":                 hour,
        "day_of_week":          day_of_week,
        "suspicious_hour":      1 if hour < 5 or hour > 22 else 0,
        "foreign_location":     1 if "foreign" in location else 0,
        "known_device":         1 if len(device_id) > 3 else 0,
        "transaction_type_enc": type_map.get(tx_type, 0),
    }

    X = pd.DataFrame([features])[_features]
    X_sc = _scaler.transform(X)
    score = float(_model.predict_proba(X_sc)[0][1])

    if score >= 0.8:
        confidence = "HIGH"
    elif score >= 0.5:
        confidence = "MEDIUM"
    else:
        confidence = "LOW"

    return {
        "fraud_score": round(score, 4),
        "is_fraud_ml": score >= 0.5,
        "confidence":  confidence,
    }


def is_model_available() -> bool:
    """Vérifie si le modèle est prêt à être utilisé."""
    return os.path.exists(_MODEL_PATH)


# ── Test rapide si lancé directement ─────────────────────────────────────────
if __name__ == "__main__":
    normal_tx = {
        "amount": 120, "timestamp": "2026-05-08T14:30:00",
        "location": "Casablanca", "device_id": "DEV_001",
        "transaction_type": "purchase"
    }
    suspect_tx = {
        "amount": 1950, "timestamp": "2026-05-08T02:15:00",
        "location": "foreign_location", "device_id": "DEV_NEW",
        "transaction_type": "transfer"
    }

    for tx, label in [(normal_tx, "Normale"), (suspect_tx, "Suspecte")]:
        result = score_transaction(tx)
        print(f"[{label}] Score={result['fraud_score']} | "
              f"Fraude={result['is_fraud_ml']} | "
              f"Confiance={result['confidence']}")